{% if projects %}
\section*{Projects}
{% for project in projects %}
\textbf{ {{ project.name }} }

{% if project.technologies %}\textit{ {{ project.technologies|join(", ") }} }{% endif %}

{% if project.description %}{{ project.description }}{% endif %}

\begin{itemize}[leftmargin=*]
{% for highlight in project.highlights %}
\item {{ highlight }}
{% endfor %}
\end{itemize}

{% endfor %}
