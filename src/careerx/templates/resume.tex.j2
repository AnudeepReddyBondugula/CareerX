{% if profile.linkedin %}\href{ {{- profile.linkedin -}} }{LinkedIn}{% endif %}
{% if profile.github %}{% if profile.linkedin %}\;|\;{% endif %}\href{ {{- profile.github -}} }{GitHub}{% endif %}
{% if profile.portfolio %}{% if profile.linkedin or profile.github %}\;|\;{% endif %}\href{ {{- profile.portfolio -}} }{Portfolio}{% endif %}
