\section*{Education}
{% for edu in education %}
\textbf{ {{ edu.degree }} }{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}\hfill {{ edu.start_date }} -- {{ edu.end_date }}

{{ edu.institution }}

