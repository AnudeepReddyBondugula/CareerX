\textbf{ {{ category }}: } {{ items|join(", ") }}

{% endfor %}
{% endif %}

{% if experiences %}
\section*{Professional Experience}
{% for experience in experiences %}
\textbf{ {{ experience.title }} }{% if experience.company %}\hfill {{ experience.company }}{% endif %}

{% if experience.location %}{{ experience.location }}{% endif %}{% if experience.start_date %}\hfill {{ experience.start_date }} -- {% if experience.currently_working %}Present{% else %}{{ experience.end_date }}{% endif %}{% endif %}

\begin{itemize}[leftmargin=*]
{% for achievement in experience.achievements %}
\item {{ achievement }}
{% endfor %}
\end{itemize}
{% endfor %}
