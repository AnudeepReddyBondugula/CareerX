<# ===================================================================== #>
<# CareerX - Trey Hunner resume template                                  #>
<#                                                                        #>
<# Jinja delimiters are remapped to avoid clashing with LaTeX braces:      #>
<# expressions use angle-brackets, statements use angle-percent, and these #>
<# comments use angle-hash.                                                #>
<#                                                                        #>
<# Every interpolated value is LaTeX-escaped by the renderer's `finalize`  #>
<# hook. Hyperlink targets are pre-escaped as LatexSafe by the renderer.   #>
<#                                                                        #>
<# Requires assets/resume.cls (Trey Hunner, via LaTeXTemplates.com) and    #>
<# the fontawesome5 package.                                              #>
<# ===================================================================== #>
\documentclass{resume}

\usepackage[left=0.4in,top=0.3in,right=0.4in,bottom=0.3in]{geometry}
\usepackage{array}
\usepackage{fontawesome5}
\usepackage[hidelinks]{hyperref}

\name{<< profile.full_name >>}

<% if contact_links %>
\address{
<% for link in contact_links %>
<% if not loop.first %>
    \addressSep\ 
<% endif %>
<% if link.target %>
    \href{<< link.target >>}{<< link.icon >>\ << link.label >>}
<% else %>
    << link.icon >>\ << link.label >>
<% endif %>
<% endfor %>
}
<% endif %>

\begin{document}

<% if summary %>
\begin{rSection}{SUMMARY}
<< summary >>
\end{rSection}
<% endif %>

<% if experiences %>
\begin{rSection}{EXPERIENCE}
<% for experience in experiences %>
\begin{rSubsection}{<< experience.company >>}{<< experience.start_date >><% if experience.end_date %> -- << experience.end_date >><% endif %>}{<< experience.title >>}{<< experience.location >>}
<% for achievement in experience.achievements %>
\item << achievement >>
<% endfor %>
<% if not experience.achievements %>
\item[] <# an rSubsection body is a LaTeX list, which must not be empty #>
<% endif %>
\end{rSubsection}
<% endfor %>
\end{rSection}
<% endif %>

<% if projects %>
\begin{rSection}{PROJECTS}
<% for project in projects %>
\begin{rSubsection}{<< project.name >><% if project.technologies %> $|$ \textit{<< project.technologies | join(", ") >>}<% endif %>}{}{}{}
<% for point in project.description %>
\item << point >>
<% endfor %>
<% if project.github or project.live_demo %>
\item <% if project.github %>\href{<< project.github | url >>}{\faGithub\ Source}<% endif %><% if project.github and project.live_demo %> \quad <% endif %><% if project.live_demo %>\href{<< project.live_demo | url >>}{\faExternalLinkAlt\ Live demo}<% endif %>

<% endif %>
<% if not project.description and not project.github and not project.live_demo %>
\item[]
<% endif %>
\end{rSubsection}
<% endfor %>
\end{rSection}
<% endif %>

<% if skill_groups %>
\begin{rSection}{SKILLS}
\begin{tabular}{@{} >{\bfseries}l @{\hspace{4ex}} p{0.76\textwidth} @{}}
<% for category, names in skill_groups %>
<< category >> & << names | join(", ") >> \\
<% endfor %>
\end{tabular}
\end{rSection}
<% endif %>

<% if education %>
\begin{rSection}{EDUCATION}
<% for edu in education %>
{\bf << edu.institution >>} \hfill << edu.start_date >><% if edu.end_date %> -- << edu.end_date >><% endif %>
\\
<< edu.degree >><% if edu.field_of_study %> in << edu.field_of_study >><% endif %><% if edu.grade %>, << edu.grade >><% endif %>

<% endfor %>
\end{rSection}
<% endif %>

<% if achievements or certifications %>
\begin{rSection}{CERTIFICATIONS \& ACHIEVEMENTS}
\begin{list}{$\bullet$}{\leftmargin=1.5em \itemsep 0pt \parsep 0pt}
<% for achievement in achievements %>
\item {\bf << achievement.title >>}<% if achievement.description %> --- << achievement.description >><% endif %>

<% endfor %>
<% for certification in certifications %>
\item << certification.name >><% if certification.issuer %> --- << certification.issuer >><% endif %>

<% endfor %>
\end{list}
\end{rSection}
<% endif %>

\end{document}
