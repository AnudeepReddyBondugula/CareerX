# ---------------------------------------------------------------------------
# CareerX configuration. Copy to `.env` and fill in one provider's API key.
# Every value here is optional except the key for your chosen provider.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# "gemini" (has a free tier) or "openai".
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Point at an OpenAI-compatible gateway if you use one.
# OPENAI_BASE_URL=

TEMPERATURE=0.2
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=90

# --- Retrieval --------------------------------------------------------------
# auto                  : provider API, then sentence-transformers, then hashing
# provider              : provider embedding API only
# sentence-transformers : local MiniLM (needs the `local-embeddings` extra)
# hashing               : deterministic, dependency-free, no network
EMBEDDING_BACKEND=auto
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=6

# --- Rendering --------------------------------------------------------------
DEFAULT_TEMPLATE=treyHunner
# Force an engine; otherwise tectonic is preferred, then pdflatex.
# LATEX_ENGINE=tectonic
LATEX_TIMEOUT_SECONDS=120

# --- Web service ------------------------------------------------------------
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# "json" for hosted log drains, "text" for humans.
LOG_FORMAT=text

# Comma-separated, or a JSON array. "*" allows any origin.
CORS_ALLOW_ORIGINS=*

# Generated artifacts are deleted this many seconds after a run.
ARTIFACT_DIR=/tmp/careerx-artifacts
ARTIFACT_TTL_SECONDS=1800

MAX_UPLOAD_BYTES=1048576
MAX_JOB_DESCRIPTION_CHARS=30000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Behaviour --------------------------------------------------------------
# true fails a run that produced ungrounded content instead of removing it.
STRICT_GROUNDING=false
